{
  "name": "coreui-free-angular-admin-template",
  "version": "5.6.12",
  "copyright": "Copyright 2026 creativeLabs Łukasz Holeczek",
  "license": "MIT",
  "author": "The CoreUI Team (https://github.com/orgs/coreui/people) and contributors",
  "homepage": "https://coreui.io/angular",
  "config": {
    "theme": "default",
    "coreui_library_short_version": "5.6",
    "coreui_library_docs_url": "https://coreui.io/angular/docs/"
  },
  "scripts": {
    "ng": "ng",
    "certs:https": "powershell -ExecutionPolicy Bypass -File .\\scripts\\generate-local-https.ps1 -LanHost 192.168.1.83",
    "start": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json -o",
    "start:local": "ng serve --proxy-config proxy.conf.json -o",
    "start:lan": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:proxy": "ng serve --host 0.0.0.0 --port 4200 --proxy-config proxy.conf.json",
    "start:https": "ng serve --host localhost --port 4200 --ssl true --ssl-cert ../dev-certs/local-https/dev-local.pem --ssl-key ../dev-certs/local-https/dev-local-key.pem --proxy-config proxy.conf.json -o",
    "start:https:lan": "ng serve --host 0.0.0.0 --port 4200 --ssl true --ssl-cert ../dev-certs/local-https/dev-local.pem --ssl-key ../dev-certs/local-https/dev-local-key.pem --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "prebuild": "ng test --watch=false --browsers=ChromeHeadless",
    "test": "ng test"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.1.3",
    "@angular/cdk": "^21.1.3",
    "@angular/common": "^21.1.3",
    "@angular/compiler": "^21.1.3",
    "@angular/core": "^21.1.3",
    "@angular/forms": "^21.1.3",
    "@angular/language-service": "^21.1.3",
    "@angular/localize": "^21.1.3",
    "@angular/platform-browser": "^21.1.3",
    "@angular/platform-browser-dynamic": "^21.1.3",
    "@angular/router": "^21.1.3",
    "@coreui/angular": "~5.6.12",
    "@coreui/angular-chartjs": "~5.6.12",
    "@coreui/chartjs": "~4.1.0",
    "@coreui/coreui": "~5.5.0",
    "@coreui/icons": "^3.0.1",
    "@coreui/icons-angular": "~5.6.12",
    "@coreui/utils": "^2.0.2",
    "@stomp/stompjs": "^7.3.0",
    "chart.js": "^4.5.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lodash-es": "^4.17.23",
    "ngx-scrollbar": "^13.0.3",
    "rxjs": "~7.8.2",
    "sockjs-client": "^1.6.1",
    "sweetalert2": "^11.26.22",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.3",
    "@types/jasmine": "^6.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.10.10",
    "@types/sockjs-client": "^1.5.4",
    "jasmine-core": "^6.0.1",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0",
    "npm": ">=10"
  },
